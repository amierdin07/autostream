<% layout('layout') -%>

<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2 border-b border-gray-800">
    <div>
      <h2 class="text-2xl font-bold flex items-center gap-2 text-white">
        <i class="ti ti-upload text-primary"></i>
        <span>Upload Reguler</span>
      </h2>
      <p class="text-gray-400 text-sm mt-1">Upload video biasa (bukan live stream) langsung ke channel YouTube Anda</p>
    </div>
    
    <% if (youtubeConnected && youtubeChannels.length > 0) { %>
    <div class="flex items-center gap-2 bg-dark-700/60 border border-gray-700 px-3 py-1.5 rounded-lg text-xs text-gray-300 self-start md:self-auto">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span><%= youtubeChannels.length %> Channel YouTube Terhubung</span>
    </div>
    <% } %>
  </div>

  <% if (!youtubeConnected || youtubeChannels.length === 0) { %>
  <!-- YouTube Connection Warning Banner -->
  <div class="bg-yellow-900/20 border border-yellow-600/30 rounded-xl p-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="w-12 h-12 bg-yellow-500/20 rounded-xl flex items-center justify-center flex-shrink-0">
        <i class="ti ti-brand-youtube text-yellow-400 text-2xl"></i>
      </div>
      <div class="flex-1">
        <h3 class="text-base font-semibold text-yellow-200">Koneksi YouTube Diperlukan</h3>
        <p class="text-yellow-300/80 text-sm mt-0.5">Untuk mengunggah video ke YouTube, Anda perlu menghubungkan akun/channel YouTube terlebih dahulu melalui menu Settings.</p>
      </div>
      <a href="/settings?activeTab=integration" class="flex items-center gap-2 px-4 py-2 bg-yellow-600 hover:bg-yellow-500 text-white font-medium text-sm rounded-lg transition-all shadow-md">
        <i class="ti ti-plug"></i>
        <span>Hubungkan YouTube</span>
      </a>
    </div>
  </div>
  <% } else { %>

  <!-- Live Progress Banner (Hidden by default) -->
  <div id="liveProgressContainer" class="hidden bg-dark-800 border border-primary/40 rounded-xl p-5 shadow-lg relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-transparent pointer-events-none"></div>
    <div class="flex items-center justify-between mb-2">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-primary/20 flex items-center justify-center text-primary animate-spin">
          <i class="ti ti-loader-2 text-lg"></i>
        </div>
        <div>
          <h4 id="progressVideoTitle" class="text-sm font-semibold text-white">Mengupload video ke YouTube...</h4>
          <p id="progressStatusText" class="text-xs text-gray-400">Memproses upload media...</p>
        </div>
      </div>
      <span id="progressPercentage" class="text-base font-bold text-primary tabular-nums">0%</span>
    </div>
    <div class="w-full bg-dark-700 rounded-full h-2 overflow-hidden mt-3">
      <div id="progressBarFill" class="bg-gradient-to-r from-blue-500 to-primary h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
    </div>
  </div>

  <!-- Main Upload Form Grid -->
  <form id="regularUploadForm" onsubmit="submitRegularUpload(event)" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Left Column: Video Source & Metadata (2 spans) -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Card 1: Channel & Video Source Selection -->
        <div class="bg-dark-800 border border-gray-700/80 rounded-xl p-5 shadow-sm space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-gray-700/60">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-300 flex items-center gap-2">
              <i class="ti ti-video text-primary"></i>
              <span>1. Target Channel & Sumber Video</span>
            </h3>
          </div>

          <!-- Channel Selector -->
          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1.5">Channel YouTube Tujuan <span class="text-red-400">*</span></label>
            <select name="youtube_channel_id" id="channelSelect" onchange="onChannelChange()" required class="w-full px-3.5 py-2.5 bg-dark-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all">
              <% youtubeChannels.forEach(channel => { %>
                <option value="<%= channel.id %>" <%= channel.is_default ? 'selected' : '' %>>
                  <%= channel.channel_name %> (<%= channel.subscriber_count || '0' %> subscribers)
                </option>
              <% }); %>
            </select>
          </div>

          <!-- Video Source Type Selector -->
          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1.5">Pilih Sumber Video <span class="text-red-400">*</span></label>
            <div class="grid grid-cols-2 gap-3">
              <button type="button" id="tabSrcGallery" onclick="switchVideoSource('gallery')" class="flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg border text-sm font-medium transition-all bg-primary/20 border-primary text-primary shadow-sm">
                <i class="ti ti-library"></i>
                <span>Pilih dari Gallery</span>
              </button>
              <button type="button" id="tabSrcUpload" onclick="switchVideoSource('upload')" class="flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg border text-sm font-medium transition-all bg-dark-700 border-gray-600 text-gray-300 hover:text-white hover:border-gray-500">
                <i class="ti ti-cloud-upload"></i>
                <span>Upload File Baru</span>
              </button>
            </div>
          </div>

          <!-- Source A: Select from Gallery -->
          <div id="sectionSourceGallery" class="space-y-2">
            <label class="block text-xs font-medium text-gray-400">Pilih Video yang Sudah Ada di Galeri</label>
            <% if (videos && videos.length > 0) { %>
            <select name="video_id" id="galleryVideoSelect" onchange="onGalleryVideoSelect()" class="w-full px-3.5 py-2.5 bg-dark-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all">
              <option value="">-- Pilih salah satu video dari galeri --</option>
              <% videos.forEach(vid => { %>
                <option value="<%= vid.id %>" data-title="<%= vid.title %>" data-thumb="<%= vid.thumbnail_path || '' %>" data-duration="<%= vid.duration || '' %>" data-res="<%= vid.resolution || '' %>">
                  <%= vid.title %> <%= vid.resolution ? `(${vid.resolution})` : '' %>
                </option>
              <% }); %>
            </select>
            <div id="galleryVideoPreviewBox" class="hidden items-center gap-3 p-3 bg-dark-900/60 border border-gray-700 rounded-lg mt-2">
              <div class="w-16 h-10 bg-dark-700 rounded overflow-hidden flex-shrink-0 flex items-center justify-center">
                <img id="galleryVideoThumbImg" src="" alt="Thumbnail" class="w-full h-full object-cover hidden">
                <i id="galleryVideoThumbIcon" class="ti ti-video text-gray-500"></i>
              </div>
              <div class="flex-1 min-w-0">
                <p id="galleryVideoTitleText" class="text-xs font-semibold text-white truncate"></p>
                <p id="galleryVideoMetaText" class="text-[11px] text-gray-400"></p>
              </div>
            </div>
            <% } else { %>
            <div class="p-4 bg-dark-900/40 border border-dashed border-gray-700 rounded-lg text-center">
              <p class="text-xs text-gray-400">Belum ada video di Galeri. Silakan pilih tab "Upload File Baru" atau upload di menu Gallery.</p>
            </div>
            <% } %>
          </div>

          <!-- Source B: Upload New File -->
          <div id="sectionSourceUpload" class="hidden space-y-2">
            <label class="block text-xs font-medium text-gray-400">Pilih file video dari perangkat Anda (.mp4, .avi, .mov)</label>
            <div id="dropZoneVideo" class="border-2 border-dashed border-gray-600 hover:border-primary/80 rounded-xl p-6 text-center cursor-pointer transition-colors bg-dark-900/40" onclick="document.getElementById('videoFileInput').click()">
              <input type="file" id="videoFileInput" name="video_file" accept="video/mp4,video/avi,video/quicktime" class="hidden" onchange="handleVideoFileSelect(this)">
              <div id="dropZonePlaceholder">
                <div class="w-12 h-12 rounded-full bg-primary/10 text-primary mx-auto flex items-center justify-center mb-3">
                  <i class="ti ti-cloud-upload text-2xl"></i>
                </div>
                <p class="text-sm font-medium text-white">Klik untuk memilih file atau drag & drop ke sini</p>
                <p class="text-xs text-gray-400 mt-1">Format didukung: MP4, AVI, MOV</p>
              </div>
              <div id="dropZoneFileSelected" class="hidden flex-col p-3 bg-dark-700/80 rounded-lg text-left gap-2.5">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3 min-w-0">
                    <i class="ti ti-file-video text-2xl text-primary flex-shrink-0"></i>
                    <div class="min-w-0">
                      <p id="selectedFileName" class="text-sm font-semibold text-white truncate max-w-xs md:max-w-md"></p>
                      <p id="selectedFileSize" class="text-xs text-gray-400"></p>
                    </div>
                  </div>
                  <button type="button" onclick="event.stopPropagation(); clearVideoFileInput()" class="text-gray-400 hover:text-red-400 p-1 flex-shrink-0" title="Batal pilih file">
                    <i class="ti ti-x text-lg"></i>
                  </button>
                </div>
                <div id="fileUploadProgressContainer" class="w-full pt-1.5 border-t border-gray-600/40">
                  <div class="w-full bg-dark-900 rounded-full h-1.5 overflow-hidden">
                    <div id="fileUploadProgressBar" class="bg-primary h-1.5 rounded-full transition-all duration-150" style="width: 0%"></div>
                  </div>
                  <div class="flex items-center justify-between mt-1 text-[11px]">
                    <span id="fileUploadProgressText" class="text-blue-400 flex items-center gap-1.5">
                      <i class="ti ti-loader-2 animate-spin text-xs"></i>
                      <span>Mengunggah ke VPS (0%)...</span>
                    </span>
                    <span id="fileUploadPercentText" class="text-gray-400 font-semibold tabular-nums">0%</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2: Metadata Details -->
        <div class="bg-dark-800 border border-gray-700/80 rounded-xl p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-gray-700/60">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-300 flex items-center gap-2">
              <i class="ti ti-file-text text-primary"></i>
              <span>2. Informasi Video (Metadata)</span>
            </h3>
            <button type="button" onclick="loadChannelDefaultSeo(true)" class="text-xs text-primary hover:text-blue-400 flex items-center gap-1.5 transition-all px-2.5 py-1 rounded-md bg-primary/10 hover:bg-primary/20 border border-primary/20" title="Muat ulang template SEO channel ke form">
              <i class="ti ti-refresh text-xs"></i>
              <span>Terapkan SEO Channel</span>
            </button>
          </div>

          <!-- Video Title -->
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label class="text-xs font-semibold text-gray-300">Judul Video <span class="text-red-400">*</span></label>
              <span id="titleCharCount" class="text-[11px] text-gray-500">0/100</span>
            </div>
            <input type="text" name="title" id="videoTitleInput" maxlength="100" required oninput="updateTitleCount()" class="w-full px-3.5 py-2.5 bg-dark-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="Masukkan judul video YouTube...">
          </div>

          <!-- Video Description -->
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label class="text-xs font-semibold text-gray-300">Deskripsi</label>
              <span id="descCharCount" class="text-[11px] text-gray-500">0/5000</span>
            </div>
            <textarea name="description" id="videoDescInput" rows="5" maxlength="5000" oninput="updateDescCount()" class="w-full px-3.5 py-2.5 bg-dark-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all resize-y" placeholder="Tulis deskripsi video YouTube, link sosial media, hashtag, dsb..."></textarea>
          </div>

          <!-- Tags Input -->
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label class="text-xs font-semibold text-gray-300">Tags / Kata Kunci</label>
              <span id="tagsCharCount" class="text-[11px] text-gray-500">0/500</span>
            </div>
            <div id="tagsContainer" class="flex flex-wrap gap-1.5 p-2 bg-dark-700 border border-gray-600 rounded-lg min-h-[44px] items-center">
              <div id="tagsChips" class="flex flex-wrap gap-1.5"></div>
              <input type="text" id="tagInput" onkeydown="handleTagKeydown(event)" class="bg-transparent border-none outline-none text-white text-xs placeholder-gray-500 flex-1 min-w-[120px]" placeholder="Ketik tag lalu tekan Enter atau koma...">
            </div>
            <input type="hidden" name="tags" id="hiddenTagsInput">
            <p class="text-[11px] text-gray-500 mt-1">Gunakan Enter atau koma untuk memisahkan tag (maksimal 500 karakter total).</p>
          </div>

          <!-- Category & Playlist -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-gray-300 mb-1.5">Kategori</label>
              <select name="category_id" id="categorySelect" class="w-full px-3.5 py-2.5 bg-dark-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all">
                <option value="22" selected>People & Blogs</option>
                <option value="24">Entertainment</option>
                <option value="20">Gaming</option>
                <option value="10">Music</option>
                <option value="28">Science & Technology</option>
                <option value="17">Sports</option>
                <option value="27">Education</option>
                <option value="26">Howto & Style</option>
                <option value="19">Travel & Events</option>
                <option value="1">Film & Animation</option>
                <option value="25">News & Politics</option>
                <option value="23">Comedy</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-300 mb-1.5">Tambahkan ke Playlist (Opsional)</label>
              <select name="playlist_id" id="playlistSelect" class="w-full px-3.5 py-2.5 bg-dark-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all">
                <option value="">-- Tanpa Playlist --</option>
                <% if (playlists && playlists.length > 0) { %>
                  <% playlists.forEach(pl => { %>
                    <option value="<%= pl.id %>"><%= pl.title %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>
          </div>

        </div>

      </div>

      <!-- Right Column: Thumbnail, Privacy, Publishing & Submit (1 span) -->
      <div class="space-y-6">
        
        <!-- Card 3: Custom Thumbnail -->
        <div class="bg-dark-800 border border-gray-700/80 rounded-xl p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-gray-700/60">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-300 flex items-center gap-2">
              <i class="ti ti-photo text-primary"></i>
              <span>3. Custom Thumbnail</span>
            </h3>
          </div>

          <div class="space-y-3">
            <div id="thumbPreviewArea" class="aspect-video bg-dark-900/60 border border-gray-700 rounded-lg overflow-hidden flex items-center justify-center relative group cursor-pointer" onclick="document.getElementById('thumbnailFileInput').click()">
              <img id="thumbnailPreviewImg" src="" alt="Thumbnail Preview" class="w-full h-full object-cover hidden">
              <div id="thumbnailPlaceholder" class="flex flex-col items-center justify-center p-4 text-center">
                <i class="ti ti-photo-plus text-3xl text-gray-500 mb-1 group-hover:text-primary transition-colors"></i>
                <p class="text-xs text-gray-400 font-medium">Klik untuk upload thumbnail</p>
                <p class="text-[10px] text-gray-500 mt-0.5">JPG, PNG, GIF (Maks. 2MB, rasio 16:9)</p>
              </div>
              <button type="button" id="removeThumbBtn" onclick="event.stopPropagation(); clearThumbnailInput()" class="hidden absolute top-2 right-2 bg-black/70 hover:bg-red-600 text-white p-1 rounded-md transition-colors">
                <i class="ti ti-x text-sm"></i>
              </button>
            </div>
            <input type="file" id="thumbnailFileInput" name="thumbnail_file" accept="image/jpeg,image/png,image/gif" class="hidden" onchange="handleThumbnailSelect(this)">
          </div>
        </div>

        <!-- Card 4: Visibility & Publishing Settings -->
        <div class="bg-dark-800 border border-gray-700/80 rounded-xl p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-gray-700/60">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-300 flex items-center gap-2">
              <i class="ti ti-eye text-primary"></i>
              <span>4. Visibilitas & Jadwal</span>
            </h3>
          </div>

          <!-- Privacy Status -->
          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1.5">Visibilitas Video</label>
            <div class="grid grid-cols-3 gap-2">
              <label class="cursor-pointer">
                <input type="radio" name="privacy_status" value="public" checked class="peer hidden" onchange="toggleScheduleBox()">
                <div class="p-2.5 text-center rounded-lg border border-gray-700 bg-dark-700 peer-checked:border-primary peer-checked:bg-primary/10 peer-checked:text-primary transition-all">
                  <i class="ti ti-world block text-base mb-1"></i>
                  <span class="text-xs font-medium">Public</span>
                </div>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="privacy_status" value="unlisted" class="peer hidden" onchange="toggleScheduleBox()">
                <div class="p-2.5 text-center rounded-lg border border-gray-700 bg-dark-700 peer-checked:border-primary peer-checked:bg-primary/10 peer-checked:text-primary transition-all">
                  <i class="ti ti-link block text-base mb-1"></i>
                  <span class="text-xs font-medium">Unlisted</span>
                </div>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="privacy_status" value="private" class="peer hidden" onchange="toggleScheduleBox()">
                <div class="p-2.5 text-center rounded-lg border border-gray-700 bg-dark-700 peer-checked:border-primary peer-checked:bg-primary/10 peer-checked:text-primary transition-all">
                  <i class="ti ti-lock block text-base mb-1"></i>
                  <span class="text-xs font-medium">Private</span>
                </div>
              </label>
            </div>
          </div>

          <!-- Scheduled Publishing Toggle -->
          <div class="pt-2 border-t border-gray-700/60">
            <div class="flex items-center justify-between">
              <div>
                <label for="scheduleToggle" class="text-xs font-semibold text-gray-300 cursor-pointer">Jadwalkan Rilis</label>
                <p class="text-[11px] text-gray-500">Video otomatis dipublikasikan di waktu tertentu</p>
              </div>
              <input type="checkbox" id="scheduleToggle" onchange="toggleScheduleBox()" class="w-4 h-4 text-primary bg-dark-700 border-gray-600 rounded focus:ring-primary focus:ring-1">
            </div>

            <!-- Schedule Datetime Box -->
            <div id="scheduleDatetimeBox" class="hidden mt-3 pt-3 border-t border-gray-700/40 space-y-3">
              <div>
                <label class="block text-[11px] font-medium text-gray-400 mb-1">Tanggal & Jam Rilis</label>
                <input type="datetime-local" name="scheduled_publish_at" id="scheduledPublishAtInput" class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg text-xs text-white focus:outline-none focus:border-primary">
              </div>

              <div>
                <label class="block text-[11px] font-medium text-gray-400 mb-1.5">Metode Penjadwalan</label>
                <div class="space-y-2">
                  <label class="flex items-start gap-2.5 p-2.5 bg-dark-900/60 border border-gray-700 rounded-lg cursor-pointer hover:border-gray-600 transition-colors">
                    <input type="radio" name="schedule_mode" value="youtube" checked class="mt-0.5 text-primary focus:ring-primary">
                    <div class="text-xs">
                      <p class="font-semibold text-white">Upload ke YouTube Sekarang (Jadwal YouTube)</p>
                      <p class="text-[11px] text-gray-400 mt-0.5 leading-tight">Video langsung dikirim ke YouTube sekarang. Proses HD/4K dan copyright selesai duluan. YouTube otomatis merilisnya tepat pada jam tersebut.</p>
                    </div>
                  </label>

                  <label class="flex items-start gap-2.5 p-2.5 bg-dark-900/60 border border-gray-700 rounded-lg cursor-pointer hover:border-gray-600 transition-colors">
                    <input type="radio" name="schedule_mode" value="vps" class="mt-0.5 text-primary focus:ring-primary">
                    <div class="text-xs">
                      <p class="font-semibold text-white">Tahan di VPS (Upload Saat Jam Tiba)</p>
                      <p class="text-[11px] text-gray-400 mt-0.5 leading-tight">File video ditahan di VPS dan sama sekali belum diupload. Begitu jam jadwal tiba, VPS otomatis mengunggah video ke YouTube.</p>
                    </div>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <!-- Auto-Delete Video from VPS to Save Disk Space -->
          <div class="pt-2 border-t border-gray-700/60">
            <label class="flex items-start gap-2.5 cursor-pointer">
              <input type="checkbox" name="delete_after_upload" value="1" checked class="w-4 h-4 mt-0.5 text-primary bg-dark-700 border-gray-600 rounded focus:ring-primary focus:ring-1">
              <div class="text-xs">
                <span class="font-semibold text-gray-200">Hapus file video di VPS setelah berhasil</span>
                <p class="text-[11px] text-gray-400 mt-0.5 leading-tight">Sangat disarankan untuk menghemat ruang disk VPS. Begitu video terkonfirmasi sukses di YouTube, file video asli di server akan langsung dihapus.</p>
              </div>
            </label>
          </div>

          <!-- Made for Kids -->
          <div class="pt-2 border-t border-gray-700/60">
            <label class="block text-xs font-semibold text-gray-300 mb-1.5">Penetapan Penonton (Made for Kids)</label>
            <div class="flex items-center gap-4 text-xs text-gray-300">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="made_for_kids" value="0" checked class="text-primary focus:ring-primary">
                <span>Bukan untuk anak-anak</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="made_for_kids" value="1" class="text-primary focus:ring-primary">
                <span>Untuk anak-anak</span>
              </label>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="pt-4">
            <button type="submit" id="submitUploadBtn" class="w-full flex items-center justify-center gap-2 bg-primary hover:bg-blue-600 text-white font-medium py-3 px-4 rounded-xl shadow-lg transition-all hover:scale-[1.01] active:scale-[0.99] disabled:opacity-50 disabled:cursor-not-allowed">
              <i class="ti ti-upload text-lg"></i>
              <span id="submitUploadBtnText">Upload ke YouTube</span>
            </button>
          </div>

        </div>

      </div>

    </div>
  </form>

  <!-- History Section -->
  <div class="bg-dark-800 border border-gray-700/80 rounded-xl p-5 shadow-sm space-y-4 mt-8">
    <div class="flex items-center justify-between pb-3 border-b border-gray-700/60">
      <div>
        <h3 class="text-base font-semibold text-white flex items-center gap-2">
          <i class="ti ti-history text-primary"></i>
          <span>Riwayat Upload Reguler</span>
        </h3>
        <p class="text-xs text-gray-400 mt-0.5">Daftar video yang telah diproses atau diunggah ke YouTube</p>
      </div>
      <button onclick="fetchUploadHistory()" class="flex items-center gap-1.5 px-3 py-1.5 bg-dark-700 hover:bg-dark-600 border border-gray-600 rounded-lg text-xs text-gray-300 transition-colors">
        <i class="ti ti-refresh text-sm"></i>
        <span>Segarkan</span>
      </button>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-gray-300">
        <thead class="text-xs uppercase bg-dark-900/60 text-gray-400 border-b border-gray-700">
          <tr>
            <th class="px-4 py-3">Video</th>
            <th class="px-4 py-3">Channel</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">Tanggal</th>
            <th class="px-4 py-3 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody id="historyTableBody" class="divide-y divide-gray-700/60">
          <% if (uploads && uploads.length > 0) { %>
            <% uploads.forEach(up => { %>
              <tr class="hover:bg-dark-700/30 transition-colors" data-upload-id="<%= up.id %>">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <div class="w-14 h-9 bg-dark-700 rounded overflow-hidden flex-shrink-0 flex items-center justify-center border border-gray-700">
                      <% if (up.thumbnail_path) { %>
                        <img src="/uploads/thumbnails/<%= up.thumbnail_path.split('/').pop() %>" alt="" class="w-full h-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                        <i class="ti ti-video text-gray-500 hidden"></i>
                      <% } else { %>
                        <i class="ti ti-video text-gray-500"></i>
                      <% } %>
                    </div>
                    <div class="min-w-0">
                      <p class="text-sm font-medium text-white truncate max-w-xs md:max-w-md" title="<%= up.title %>"><%= up.title %></p>
                      <p class="text-[11px] text-gray-400">Privasi: <%= up.privacy_status %></p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 text-xs text-gray-300 whitespace-nowrap">
                  <div class="flex items-center gap-2">
                    <% if (up.channel_thumbnail) { %>
                      <img src="<%= up.channel_thumbnail %>" alt="" class="w-5 h-5 rounded-full object-cover">
                    <% } else { %>
                      <i class="ti ti-brand-youtube text-red-500"></i>
                    <% } %>
                    <span><%= up.channel_name || 'Channel' %></span>
                  </div>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <% if (up.status === 'completed') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                      <i class="ti ti-check text-xs"></i>
                      <span>Selesai</span>
                    </span>
                  <% } else if (up.status === 'uploading') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20 animate-pulse">
                      <i class="ti ti-loader-2 animate-spin text-xs"></i>
                      <span>Mengupload (<%= up.progress || 0 %>%)</span>
                    </span>
                  <% } else if (up.status === 'scheduled') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-purple-500/10 text-purple-400 border border-purple-500/20" title="Akan diupload pada <%= up.scheduled_publish_at ? new Date(up.scheduled_publish_at).toLocaleString('id-ID') : '' %>">
                      <i class="ti ti-calendar-time text-xs"></i>
                      <span>Terjadwal di VPS</span>
                    </span>
                  <% } else if (up.status === 'failed') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-red-500/10 text-red-400 border border-red-500/20" title="<%= up.error_message || '' %>">
                      <i class="ti ti-alert-circle text-xs"></i>
                      <span>Gagal</span>
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-yellow-500/10 text-yellow-400 border border-yellow-500/20">
                      <i class="ti ti-clock text-xs"></i>
                      <span>Pending</span>
                    </span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-xs text-gray-400 whitespace-nowrap">
                  <%= new Date(up.created_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <div class="flex items-center justify-end gap-2">
                    <% if (up.youtube_video_id) { %>
                      <a href="https://youtu.be/<%= up.youtube_video_id %>" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 bg-red-600/20 hover:bg-red-600/30 text-red-400 hover:text-red-300 rounded border border-red-600/30 text-xs font-medium flex items-center gap-1 transition-colors">
                        <i class="ti ti-brand-youtube"></i>
                        <span>Tonton</span>
                      </a>
                    <% } %>
                    <% if (up.status === 'failed') { %>
                      <button onclick="retryUpload('<%= up.id %>')" class="px-2.5 py-1 bg-blue-600/20 hover:bg-blue-600/30 text-blue-400 hover:text-blue-300 rounded border border-blue-600/30 text-xs font-medium flex items-center gap-1 transition-colors" title="Coba Upload Ulang">
                        <i class="ti ti-rotate-clockwise"></i>
                        <span>Coba Lagi</span>
                      </button>
                    <% } %>
                    <button onclick="deleteUploadHistory('<%= up.id %>')" class="p-1.5 text-gray-400 hover:text-red-400 rounded hover:bg-dark-700 transition-colors" title="Hapus Riwayat">
                      <i class="ti ti-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr id="emptyHistoryRow">
              <td colspan="5" class="px-4 py-8 text-center text-xs text-gray-500">
                <i class="ti ti-inbox text-3xl block mb-2 opacity-50"></i>
                Belum ada riwayat upload reguler.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <% } %>
</div>

<!-- Client Scripts for Interactivity -->
<script>
let currentSource = 'gallery';
let currentTags = [];
let activePollingInterval = null;

// YouTube Channels SEO Templates Data
const channelsList = <%- JSON.stringify((typeof youtubeChannels !== 'undefined' ? youtubeChannels : []).map(c => ({
  id: c.id,
  name: c.channel_name,
  default_description: c.default_description || '',
  default_tags: c.default_tags || '',
  default_category: c.default_category || '22'
}))) %>;

function loadChannelDefaultSeo(forceOverwrite = false) {
  const select = document.getElementById('channelSelect');
  if (!select) return;
  const channelId = select.value;
  const ch = channelsList.find(c => c.id === channelId);
  if (!ch) return;

  const descInput = document.getElementById('videoDescInput');
  const catSelect = document.getElementById('categorySelect');

  // Fill Description
  if (ch.default_description) {
    if (forceOverwrite || !descInput.value.trim()) {
      descInput.value = ch.default_description;
      updateDescCount();
    }
  }

  // Fill Tags
  if (ch.default_tags) {
    if (forceOverwrite || currentTags.length === 0) {
      const parsedTags = ch.default_tags.split(',')
        .map(t => t.trim())
        .filter(t => t.length > 0);
      currentTags = parsedTags;
      renderTags();
    }
  }

  // Fill Category
  if (ch.default_category && catSelect) {
    if (forceOverwrite || catSelect.value === '22') {
      catSelect.value = ch.default_category;
    }
  }
}

function switchVideoSource(type) {
  currentSource = type;
  const tabGallery = document.getElementById('tabSrcGallery');
  const tabUpload = document.getElementById('tabSrcUpload');
  const secGallery = document.getElementById('sectionSourceGallery');
  const secUpload = document.getElementById('sectionSourceUpload');

  if (type === 'gallery') {
    tabGallery.className = 'flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg border text-sm font-medium transition-all bg-primary/20 border-primary text-primary shadow-sm';
    tabUpload.className = 'flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg border text-sm font-medium transition-all bg-dark-700 border-gray-600 text-gray-300 hover:text-white hover:border-gray-500';
    secGallery.classList.remove('hidden');
    secUpload.classList.add('hidden');
    clearVideoFileInput();
  } else {
    tabUpload.className = 'flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg border text-sm font-medium transition-all bg-primary/20 border-primary text-primary shadow-sm';
    tabGallery.className = 'flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg border text-sm font-medium transition-all bg-dark-700 border-gray-600 text-gray-300 hover:text-white hover:border-gray-500';
    secUpload.classList.remove('hidden');
    secGallery.classList.add('hidden');
    const galSelect = document.getElementById('galleryVideoSelect');
    if (galSelect) galSelect.value = '';
    const previewBox = document.getElementById('galleryVideoPreviewBox');
    if (previewBox) previewBox.classList.add('hidden');
  }
}

function onGalleryVideoSelect() {
  const select = document.getElementById('galleryVideoSelect');
  const previewBox = document.getElementById('galleryVideoPreviewBox');
  const titleInput = document.getElementById('videoTitleInput');

  if (!select || !select.value) {
    if (previewBox) previewBox.classList.add('hidden');
    return;
  }

  const opt = select.options[select.selectedIndex];
  const title = opt.getAttribute('data-title') || '';
  const thumb = opt.getAttribute('data-thumb') || '';
  const duration = opt.getAttribute('data-duration') || '';
  const res = opt.getAttribute('data-res') || '';

  if (previewBox) {
    previewBox.classList.remove('hidden');
    previewBox.classList.add('flex');
    document.getElementById('galleryVideoTitleText').textContent = title;
    document.getElementById('galleryVideoMetaText').textContent = [res, duration ? `${Math.round(duration)}s` : ''].filter(Boolean).join(' • ');

    const img = document.getElementById('galleryVideoThumbImg');
    const icon = document.getElementById('galleryVideoThumbIcon');
    if (thumb) {
      img.src = '/uploads/thumbnails/' + thumb.split('/').pop();
      img.classList.remove('hidden');
      icon.classList.add('hidden');
    } else {
      img.classList.add('hidden');
      icon.classList.remove('hidden');
    }
  }

  if (titleInput && (!titleInput.value || titleInput.value.trim() === '')) {
    titleInput.value = title;
    updateTitleCount();
  }
}

let currentActiveFileJob = null;
const activeLocalQueue = new Map();

function handleVideoFileSelect(input) {
  if (!input.files || input.files.length === 0) return;
  const file = input.files[0];

  const placeholder = document.getElementById('dropZonePlaceholder');
  const fileSelected = document.getElementById('dropZoneFileSelected');
  const nameEl = document.getElementById('selectedFileName');
  const sizeEl = document.getElementById('selectedFileSize');
  const bar = document.getElementById('fileUploadProgressBar');
  const text = document.getElementById('fileUploadProgressText');
  const pctText = document.getElementById('fileUploadPercentText');

  placeholder.classList.add('hidden');
  fileSelected.classList.remove('hidden');
  fileSelected.classList.add('flex');
  nameEl.textContent = file.name;
  sizeEl.textContent = formatBytes(file.size);

  const titleInput = document.getElementById('videoTitleInput');
  if (titleInput && (!titleInput.value || titleInput.value.trim() === '')) {
    const base = file.name.substring(0, file.name.lastIndexOf('.')) || file.name;
    titleInput.value = base;
    updateTitleCount();
  }

  // Create job tracking object
  const jobId = 'local_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
  currentActiveFileJob = {
    id: jobId,
    file: file,
    title: (titleInput ? titleInput.value : file.name) || file.name,
    status: 'uploading_to_vps',
    progress: 0,
    videoId: null,
    pendingSubmit: null,
    error: null
  };
  activeLocalQueue.set(jobId, currentActiveFileJob);

  if (bar) bar.style.width = '0%';
  if (pctText) pctText.textContent = '0%';
  if (text) {
    text.innerHTML = `<i class="ti ti-loader-2 animate-spin text-xs"></i><span>Mengunggah ke VPS (0%)...</span>`;
    text.className = 'text-blue-400 flex items-center gap-1.5';
  }

  // START UPLOAD IMMEDIATELY IN THE BACKGROUND
  startBackgroundChunkedUpload(currentActiveFileJob);
}

function clearVideoFileInput() {
  const input = document.getElementById('videoFileInput');
  if (input) input.value = '';
  document.getElementById('dropZonePlaceholder').classList.remove('hidden');
  const sel = document.getElementById('dropZoneFileSelected');
  if (sel) {
    sel.classList.add('hidden');
    sel.classList.remove('flex');
  }
  currentActiveFileJob = null;
}

function handleThumbnailSelect(input) {
  if (!input.files || input.files.length === 0) return;
  const file = input.files[0];
  const reader = new FileReader();
  reader.onload = function(e) {
    const img = document.getElementById('thumbnailPreviewImg');
    const placeholder = document.getElementById('thumbnailPlaceholder');
    const removeBtn = document.getElementById('removeThumbBtn');
    img.src = e.target.result;
    img.classList.remove('hidden');
    placeholder.classList.add('hidden');
    removeBtn.classList.remove('hidden');
  };
  reader.readAsDataURL(file);
}

function clearThumbnailInput() {
  const input = document.getElementById('thumbnailFileInput');
  if (input) input.value = '';
  const img = document.getElementById('thumbnailPreviewImg');
  const placeholder = document.getElementById('thumbnailPlaceholder');
  const removeBtn = document.getElementById('removeThumbBtn');
  if (img) {
    img.src = '';
    img.classList.add('hidden');
  }
  if (placeholder) placeholder.classList.remove('hidden');
  if (removeBtn) removeBtn.classList.add('hidden');
}

function updateTitleCount() {
  const input = document.getElementById('videoTitleInput');
  const count = document.getElementById('titleCharCount');
  if (input && count) {
    count.textContent = `${input.value.length}/100`;
  }
}

function updateDescCount() {
  const input = document.getElementById('videoDescInput');
  const count = document.getElementById('descCharCount');
  if (input && count) {
    count.textContent = `${input.value.length}/5000`;
  }
}

function handleTagKeydown(e) {
  if (e.key === 'Enter' || e.key === ',') {
    e.preventDefault();
    const val = e.target.value.trim().replace(/^,|,$/g, '');
    if (val && !currentTags.includes(val)) {
      currentTags.push(val);
      renderTags();
    }
    e.target.value = '';
  }
}

function removeTag(tag) {
  currentTags = currentTags.filter(t => t !== tag);
  renderTags();
}

function renderTags() {
  const container = document.getElementById('tagsChips');
  const hiddenInput = document.getElementById('hiddenTagsInput');
  const countSpan = document.getElementById('tagsCharCount');
  if (!container) return;

  container.innerHTML = '';
  currentTags.forEach(tag => {
    const chip = document.createElement('span');
    chip.className = 'inline-flex items-center gap-1 px-2 py-1 bg-dark-900 border border-gray-600 rounded-md text-xs text-primary font-medium';
    chip.innerHTML = `<span>${escapeHtml(tag)}</span><button type="button" onclick="removeTag('${escapeHtml(tag)}')">&times;</button>`;
    container.appendChild(chip);
  });

  const joined = currentTags.join(',');
  if (hiddenInput) hiddenInput.value = joined;
  if (countSpan) countSpan.textContent = `${joined.length}/500`;
}

function toggleScheduleBox() {
  const isScheduled = document.getElementById('scheduleToggle').checked;
  const box = document.getElementById('scheduleDatetimeBox');
  if (box) {
    if (isScheduled) {
      box.classList.remove('hidden');
    } else {
      box.classList.add('hidden');
      const input = document.getElementById('scheduledPublishAtInput');
      if (input) input.value = '';
    }
  }
}

async function onChannelChange() {
  const select = document.getElementById('channelSelect');
  if (!select) return;
  const channelId = select.value;

  // Auto-populate channel SEO preset
  loadChannelDefaultSeo(true);

  const playlistSelect = document.getElementById('playlistSelect');
  if (!playlistSelect) return;

  playlistSelect.innerHTML = '<option value="">Memuat playlist...</option>';

  try {
    const res = await fetch(`/api/reguler/playlists/${channelId}`);
    const data = await res.json();
    playlistSelect.innerHTML = '<option value="">-- Tanpa Playlist --</option>';
    if (data.success && data.playlists) {
      data.playlists.forEach(pl => {
        const opt = document.createElement('option');
        opt.value = pl.id;
        opt.textContent = pl.title;
        playlistSelect.appendChild(opt);
      });
    }
  } catch (err) {
    playlistSelect.innerHTML = '<option value="">-- Tanpa Playlist --</option>';
  }
}

const CHUNK_SIZE = 25 * 1024 * 1024; // 25MB chunks for fast and reliable large uploads

async function uploadVideoChunked(file, onProgress) {
  const totalChunks = Math.ceil(file.size / CHUNK_SIZE);
  
  const initRes = await fetch('/api/videos/chunk/init', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      filename: file.name,
      fileSize: file.size,
      totalChunks,
      folderId: ''
    })
  });
  const initText = await initRes.text();
  let initData;
  try { initData = JSON.parse(initText); } catch (e) { throw new Error(`Gagal inisialisasi upload (${initRes.status}): ${initText.substring(0, 120)}`); }
  if (!initData.success) throw new Error(initData.error || 'Gagal memulai sesi upload');

  const uploadId = initData.uploadId;
  let uploaded = initData.uploadedChunks || [];

  for (let i = 0; i < totalChunks; i++) {
    if (uploaded.includes(i)) continue;
    const start = i * CHUNK_SIZE;
    const end = Math.min(start + CHUNK_SIZE, file.size);
    const chunk = file.slice(start, end);
    let retries = 3;
    while (retries > 0) {
      try {
        const chunkRes = await fetch('/api/videos/chunk/upload', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/octet-stream',
            'X-Upload-Id': uploadId,
            'X-Chunk-Index': i.toString()
          },
          body: chunk
        });
        const chunkData = await chunkRes.json();
        if (chunkData.success) {
          uploaded = chunkData.uploadedChunks || [];
          break;
        }
        throw new Error(chunkData.error || 'Gagal upload bagian file');
      } catch (err) {
        retries--;
        if (retries === 0) throw err;
        await new Promise(r => setTimeout(r, 1000));
      }
    }

    const bytesUploaded = Math.min((i + 1) * CHUNK_SIZE, file.size);
    const pct = Math.round((bytesUploaded / file.size) * 100);
    if (onProgress) onProgress(pct);
  }

  // Merge chunks on VPS
  const compRes = await fetch('/api/videos/chunk/complete', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ uploadId })
  });
  const compText = await compRes.text();
  let compData;
  try { compData = JSON.parse(compText); } catch (e) { throw new Error(`Gagal memproses file di VPS: ${compText.substring(0, 120)}`); }
  if (!compData.success || !compData.video) throw new Error(compData.error || 'Gagal memproses file di server');

  return compData.video;
}

async function startBackgroundChunkedUpload(job) {
  const bar = document.getElementById('fileUploadProgressBar');
  const text = document.getElementById('fileUploadProgressText');
  const pctText = document.getElementById('fileUploadPercentText');

  try {
    const video = await uploadVideoChunked(job.file, (pct) => {
      job.progress = pct;
      if (currentActiveFileJob && currentActiveFileJob.id === job.id) {
        if (bar) bar.style.width = `${pct}%`;
        if (pctText) pctText.textContent = `${pct}%`;
        if (text) {
          text.innerHTML = `<i class="ti ti-loader-2 animate-spin text-xs"></i><span>Mengunggah ke VPS (${pct}%)...</span>`;
        }
      }
      updateQueueRow(job);
    });

    job.videoId = video.id;
    job.status = 'ready_on_vps';

    if (currentActiveFileJob && currentActiveFileJob.id === job.id) {
      if (bar) bar.style.width = '100%';
      if (pctText) pctText.textContent = '100%';
      if (text) {
        text.innerHTML = `<i class="ti ti-check text-xs"></i><span>File siap di VPS</span>`;
        text.className = 'text-emerald-400 flex items-center gap-1.5';
      }
    }

    updateQueueRow(job);

    // If user has ALREADY submitted the form while upload was in progress:
    if (job.pendingSubmit) {
      console.log(`[Queue] Job ${job.id} finished VPS chunking. Auto-dispatching to YouTube now!`);
      await dispatchToYoutube(job.pendingSubmit, job.videoId, job.id);
    }

  } catch (err) {
    console.error('[Queue] Chunk upload failed:', err);
    job.status = 'failed';
    job.error = err.message || 'Gagal upload ke VPS';
    updateQueueRow(job);
    if (currentActiveFileJob && currentActiveFileJob.id === job.id) {
      if (text) {
        text.innerHTML = `<i class="ti ti-alert-circle text-xs"></i><span>Gagal: ${escapeHtml(job.error)}</span>`;
        text.className = 'text-red-400 flex items-center gap-1.5';
      }
    }
  }
}

async function submitRegularUpload(e) {
  e.preventDefault();

  const form = document.getElementById('regularUploadForm');

  // Validate video selection
  if (currentSource === 'gallery') {
    const vidId = document.getElementById('galleryVideoSelect')?.value;
    if (!vidId) {
      alert('Pilih video dari galeri terlebih dahulu.');
      return;
    }
  } else {
    if (!currentActiveFileJob || !currentActiveFileJob.file) {
      alert('Pilih file video yang akan diupload terlebih dahulu.');
      return;
    }
  }

  const formData = new FormData(form);
  formData.delete('video_file'); // Chunks are uploaded separately

  const title = (document.getElementById('videoTitleInput')?.value || '').trim() || 'Video';
  const channelSelect = document.getElementById('channelSelect');
  const channelName = channelSelect ? channelSelect.options[channelSelect.selectedIndex]?.text : 'Channel YouTube';

  if (currentSource === 'upload') {
    const job = currentActiveFileJob;
    job.title = title;
    job.channelName = channelName;

    if (job.videoId) {
      // Chunks already completed on VPS! Dispatch to YouTube immediately!
      await dispatchToYoutube(formData, job.videoId, null);
    } else {
      // Chunks are still uploading in background! Save submission data and queue it!
      job.pendingSubmit = formData;
      job.status = 'uploading_to_vps';
      addPendingJobToHistoryTable(job);
      showFloatingToast('info', `Tugas "${title}" disimpan! File sedang diunggah ke VPS (${job.progress}%) dan otomatis lanjut ke YouTube.`);
    }

    // RESET FORM IMMEDIATELY SO USER CAN CONFIGURE NEXT VIDEO RIGHT AWAY!
    resetFormForNextVideo();

  } else {
    // Gallery video selected
    await dispatchToYoutube(formData, formData.get('video_id'), null);
    resetFormForNextVideo();
  }
}

async function dispatchToYoutube(formData, videoId, queueJobId) {
  if (videoId) {
    formData.set('video_id', videoId);
  }
  formData.delete('video_file');

  try {
    const res = await fetch('/api/reguler/upload', {
      method: 'POST',
      body: formData
    });

    const text = await res.text();
    let data;
    try {
      data = JSON.parse(text);
    } catch (parseErr) {
      throw new Error(`Respon server tidak valid (${res.status}): ${text.substring(0, 150)}`);
    }

    if (!data.success) {
      throw new Error(data.error || 'Gagal memulai upload');
    }

    // Remove temporary queue row if present
    if (queueJobId) {
      const tempRow = document.getElementById('row_' + queueJobId);
      if (tempRow) tempRow.remove();
      activeLocalQueue.delete(queueJobId);
    }

    if (data.isScheduled) {
      showFloatingToast('success', 'Video berhasil dijadwalkan di VPS!');
    } else {
      showFloatingToast('success', 'Video berhasil didaftarkan ke YouTube!');
      startProgressTracking(data.uploadId, formData.get('title') || 'Video');
    }

    fetchUploadHistory();

  } catch (err) {
    console.error('Error dispatching to YouTube:', err);
    if (queueJobId) {
      const statusCell = document.getElementById('status_cell_' + queueJobId);
      if (statusCell) {
        statusCell.innerHTML = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-red-500/10 text-red-400 border border-red-500/20" title="${escapeHtml(err.message)}"><i class="ti ti-alert-circle text-xs"></i><span>Gagal: ${escapeHtml(err.message)}</span></span>`;
      }
    }
    showFloatingToast('error', err.message);
  }
}

function resetFormForNextVideo() {
  const form = document.getElementById('regularUploadForm');
  if (form) form.reset();
  clearVideoFileInput();
  clearThumbnailInput();
  currentActiveFileJob = null;
  currentTags = [];
  renderTags();
  toggleScheduleBox();
  switchVideoSource(currentSource);
  const galSelect = document.getElementById('galleryVideoSelect');
  if (galSelect) galSelect.value = '';
  const galPreview = document.getElementById('galleryVideoPreviewBox');
  if (galPreview) galPreview.classList.add('hidden');
  updateTitleCount();
  updateDescCount();
}

function addPendingJobToHistoryTable(job) {
  const tbody = document.getElementById('historyTableBody');
  if (!tbody) return;

  const emptyRow = document.getElementById('emptyHistoryRow');
  if (emptyRow) emptyRow.remove();

  let existing = document.getElementById('row_' + job.id);
  if (!existing) {
    existing = document.createElement('tr');
    existing.id = 'row_' + job.id;
    existing.className = 'hover:bg-dark-700/30 transition-colors bg-primary/5';
    tbody.prepend(existing);
  }

  existing.innerHTML = `
    <td class="px-4 py-3">
      <div class="flex items-center gap-3">
        <div class="w-14 h-9 bg-dark-700 rounded overflow-hidden flex-shrink-0 flex items-center justify-center border border-gray-700 text-primary">
          <i class="ti ti-file-video text-lg"></i>
        </div>
        <div class="min-w-0">
          <p class="text-sm font-medium text-white truncate max-w-xs md:max-w-md" title="${escapeHtml(job.title)}">${escapeHtml(job.title)}</p>
          <p class="text-[11px] text-gray-400">Ukuran: ${formatBytes(job.file.size)}</p>
        </div>
      </div>
    </td>
    <td class="px-4 py-3 text-xs text-gray-300 whitespace-nowrap">
      <span>${escapeHtml(job.channelName || 'YouTube')}</span>
    </td>
    <td class="px-4 py-3 whitespace-nowrap" id="status_cell_${job.id}">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20 animate-pulse">
        <i class="ti ti-loader-2 animate-spin text-xs"></i>
        <span>Upload ke VPS (${job.progress || 0}%)</span>
      </span>
    </td>
    <td class="px-4 py-3 text-xs text-gray-400 whitespace-nowrap">
      Baru saja
    </td>
    <td class="px-4 py-3 text-right whitespace-nowrap">
      <span class="text-xs text-gray-500">Memproses di background...</span>
    </td>
  `;
}

function updateQueueRow(job) {
  const cell = document.getElementById('status_cell_' + job.id);
  if (!cell) return;

  if (job.status === 'failed') {
    cell.innerHTML = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-red-500/10 text-red-400 border border-red-500/20" title="${escapeHtml(job.error)}"><i class="ti ti-alert-circle text-xs"></i><span>Gagal: ${escapeHtml(job.error)}</span></span>`;
  } else if (job.status === 'ready_on_vps') {
    cell.innerHTML = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"><i class="ti ti-check text-xs"></i><span>Siap di VPS, memproses ke YouTube...</span></span>`;
  } else {
    cell.innerHTML = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20 animate-pulse"><i class="ti ti-loader-2 animate-spin text-xs"></i><span>Upload ke VPS (${job.progress || 0}%)</span></span>`;
  }
}

function showFloatingToast(type, msg) {
  let container = document.getElementById('floatingToastContainer');
  if (!container) {
    container = document.createElement('div');
    container.id = 'floatingToastContainer';
    container.className = 'fixed top-5 right-5 z-[9999] flex flex-col gap-2 max-w-sm';
    document.body.appendChild(container);
  }

  const toast = document.createElement('div');
  const bgClass = type === 'success' ? 'bg-emerald-800 border-emerald-600 text-emerald-100' : (type === 'error' ? 'bg-red-800 border-red-600 text-red-100' : 'bg-blue-800 border-blue-600 text-blue-100');
  const iconClass = type === 'success' ? 'ti-check' : (type === 'error' ? 'ti-alert-circle' : 'ti-info-circle');

  toast.className = `p-3 rounded-xl border shadow-xl flex items-center gap-2.5 text-xs font-medium transition-all duration-300 transform translate-y-2 opacity-0 ${bgClass}`;
  toast.innerHTML = `<i class="ti ${iconClass} text-base flex-shrink-0"></i><span class="flex-1 leading-snug">${escapeHtml(msg)}</span>`;
  container.appendChild(toast);

  setTimeout(() => {
    toast.classList.remove('translate-y-2', 'opacity-0');
  }, 10);

  setTimeout(() => {
    toast.classList.add('opacity-0', 'translate-y-2');
    setTimeout(() => toast.remove(), 300);
  }, 5000);
}

function startProgressTracking(uploadId, title) {
  const container = document.getElementById('liveProgressContainer');
  const titleElem = document.getElementById('progressVideoTitle');
  const statusElem = document.getElementById('progressStatusText');
  const fillElem = document.getElementById('progressBarFill');
  const percentElem = document.getElementById('progressPercentage');

  if (container) container.classList.remove('hidden');
  if (titleElem) titleElem.textContent = title;
  if (statusElem) statusElem.textContent = 'Mengupload ke YouTube...';
  if (fillElem) fillElem.style.width = '0%';
  if (percentElem) percentElem.textContent = '0%';

  if (activePollingInterval) clearInterval(activePollingInterval);

  activePollingInterval = setInterval(async () => {
    try {
      const res = await fetch(`/api/reguler/status/${uploadId}`);
      const data = await res.json();

      if (!data.success || !data.upload) {
        clearInterval(activePollingInterval);
        return;
      }

      const up = data.upload;
      const pct = up.progress || 0;

      if (fillElem) fillElem.style.width = `${pct}%`;
      if (percentElem) percentElem.textContent = `${pct}%`;

      if (up.status === 'completed') {
        clearInterval(activePollingInterval);
        if (statusElem) statusElem.innerHTML = `<span class="text-emerald-400 font-semibold">Upload Selesai!</span> <a href="https://youtu.be/${up.youtube_video_id}" target="_blank" class="underline ml-1">Buka di YouTube</a>`;
        fetchUploadHistory();
        setTimeout(() => {
          if (container) container.classList.add('hidden');
        }, 8000);
      } else if (up.status === 'failed') {
        clearInterval(activePollingInterval);
        if (statusElem) statusElem.innerHTML = `<span class="text-red-400 font-semibold">Upload Gagal:</span> ${escapeHtml(up.error_message || 'Terjadi kesalahan')}`;
        fetchUploadHistory();
      }
    } catch (e) {
      console.warn('Failed to poll status:', e);
    }
  }, 2000);
}

async function fetchUploadHistory() {
  try {
    const res = await fetch('/api/reguler/history');
    const data = await res.json();
    if (!data.success || !data.uploads) return;

    const tbody = document.getElementById('historyTableBody');
    if (!tbody) return;

    if (data.uploads.length === 0) {
      tbody.innerHTML = `
        <tr id="emptyHistoryRow">
          <td colspan="5" class="px-4 py-8 text-center text-xs text-gray-500">
            <i class="ti ti-inbox text-3xl block mb-2 opacity-50"></i>
            Belum ada riwayat upload reguler.
          </td>
        </tr>`;
      return;
    }

    tbody.innerHTML = data.uploads.map(up => {
      let statusBadge = '';
      if (up.status === 'completed') {
        statusBadge = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"><i class="ti ti-check text-xs"></i><span>Selesai</span></span>`;
      } else if (up.status === 'uploading') {
        statusBadge = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20 animate-pulse"><i class="ti ti-loader-2 animate-spin text-xs"></i><span>Mengupload (${up.progress || 0}%)</span></span>`;
      } else if (up.status === 'scheduled') {
        const schedTime = up.scheduled_publish_at ? new Date(up.scheduled_publish_at).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) : '';
        statusBadge = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-purple-500/10 text-purple-400 border border-purple-500/20" title="Akan diupload otomatis pada ${schedTime}"><i class="ti ti-calendar-time text-xs"></i><span>Terjadwal di VPS</span></span>`;
      } else if (up.status === 'failed') {
        statusBadge = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-red-500/10 text-red-400 border border-red-500/20" title="${escapeHtml(up.error_message || '')}"><i class="ti ti-alert-circle text-xs"></i><span>Gagal</span></span>`;
      } else {
        statusBadge = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-yellow-500/10 text-yellow-400 border border-yellow-500/20"><i class="ti ti-clock text-xs"></i><span>Pending</span></span>`;
      }

      const thumbHtml = up.thumbnail_path
        ? `<img src="/uploads/thumbnails/${up.thumbnail_path.split('/').pop()}" alt="" class="w-full h-full object-cover">`
        : `<i class="ti ti-video text-gray-500"></i>`;

      const channelThumb = up.channel_thumbnail
        ? `<img src="${up.channel_thumbnail}" alt="" class="w-5 h-5 rounded-full object-cover">`
        : `<i class="ti ti-brand-youtube text-red-500"></i>`;

      const ytBtn = up.youtube_video_id
        ? `<a href="https://youtu.be/${up.youtube_video_id}" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 bg-red-600/20 hover:bg-red-600/30 text-red-400 hover:text-red-300 rounded border border-red-600/30 text-xs font-medium flex items-center gap-1 transition-colors"><i class="ti ti-brand-youtube"></i><span>Tonton</span></a>`
        : '';

      const dateStr = new Date(up.created_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' });

      return `
        <tr class="hover:bg-dark-700/30 transition-colors" data-upload-id="${up.id}">
          <td class="px-4 py-3">
            <div class="flex items-center gap-3">
              <div class="w-14 h-9 bg-dark-700 rounded overflow-hidden flex-shrink-0 flex items-center justify-center border border-gray-700">
                ${thumbHtml}
              </div>
              <div class="min-w-0">
                <p class="text-sm font-medium text-white truncate max-w-xs md:max-w-md" title="${escapeHtml(up.title)}">${escapeHtml(up.title)}</p>
                <p class="text-[11px] text-gray-400">Privasi: ${escapeHtml(up.privacy_status)}</p>
              </div>
            </div>
          </td>
          <td class="px-4 py-3 text-xs text-gray-300 whitespace-nowrap">
            <div class="flex items-center gap-2">
              ${channelThumb}
              <span>${escapeHtml(up.channel_name || 'Channel')}</span>
            </div>
          </td>
          <td class="px-4 py-3 whitespace-nowrap">
            ${statusBadge}
          </td>
          <td class="px-4 py-3 text-xs text-gray-400 whitespace-nowrap">
            ${dateStr}
          </td>
          <td class="px-4 py-3 text-right whitespace-nowrap">
            <div class="flex items-center justify-end gap-2">
              ${ytBtn}
              ${up.status === 'failed' ? `
                <button onclick="retryUpload('${up.id}')" class="px-2.5 py-1 bg-blue-600/20 hover:bg-blue-600/30 text-blue-400 hover:text-blue-300 rounded border border-blue-600/30 text-xs font-medium flex items-center gap-1 transition-colors" title="Coba Upload Ulang">
                  <i class="ti ti-rotate-clockwise"></i>
                  <span>Coba Lagi</span>
                </button>
              ` : ''}
              <button onclick="deleteUploadHistory('${up.id}')" class="p-1.5 text-gray-400 hover:text-red-400 rounded hover:bg-dark-700 transition-colors" title="Hapus Riwayat">
                <i class="ti ti-trash"></i>
              </button>
            </div>
          </td>
        </tr>`;
    }).join('');

  } catch (err) {
    console.warn('Failed to fetch history:', err);
  }
}

async function retryUpload(id) {
  try {
    const res = await fetch(`/api/reguler/retry/${id}`, {
      method: 'POST',
      headers: {
        'x-csrf-token': '<%= csrfToken %>'
      }
    });
    const data = await res.json();
    if (data.success) {
      startHistoryPolling();
    } else {
      alert('Gagal mencoba lagi: ' + (data.error || 'Terjadi kesalahan'));
    }
  } catch (err) {
    alert('Error: ' + err.message);
  }
}

async function deleteUploadHistory(id) {
  if (!confirm('Hapus riwayat upload ini? (Video yang sudah diupload ke YouTube tidak akan terhapus)')) {
    return;
  }

  try {
    const res = await fetch(`/api/reguler/${id}`, {
      method: 'DELETE',
      headers: {
        'x-csrf-token': '<%= csrfToken %>'
      }
    });
    const data = await res.json();
    if (data.success) {
      fetchUploadHistory();
    } else {
      alert('Gagal menghapus: ' + (data.error || 'Terjadi kesalahan'));
    }
  } catch (err) {
    alert('Error: ' + err.message);
  }
}

function formatBytes(bytes, decimals = 2) {
  if (!+bytes) return '0 Bytes';
  const k = 1024;
  const dm = decimals < 0 ? 0 : decimals;
  const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
}

function escapeHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

// Auto-populate default channel SEO on initial load if empty
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => loadChannelDefaultSeo(false));
} else {
  loadChannelDefaultSeo(false);
}
</script>

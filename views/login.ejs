<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Studio Login — Maybla SimaStream</title>
  <link rel="icon" href="/images/logo.svg?v=2.0" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.30.0/tabler-icons.min.css">
  <link rel="stylesheet" href="/css/styles.css">
  <% if (typeof recaptchaSiteKey !== 'undefined' && recaptchaSiteKey) { %>
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
  <% } %>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        fontFamily: {
          'sans': ['Plus Jakarta Sans', 'Inter', 'sans-serif']
        },
        extend: {
          colors: {
            'primary': '#5C6BC0',
            'coral': '#FA5B4A',
            'dark': {
              '900': '#0B0E1B',
              '800': '#151B32',
              '700': '#1C2340',
              '600': '#293356',
              '500': '#6E7997',
              '400': '#8E98B0',
              '100': '#E1E8F2',
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #0B0E1B;
      background-image: radial-gradient(circle at 50% 0%, rgba(92, 107, 192, 0.18) 0%, transparent 60%);
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .btn-coral-grad {
      background: linear-gradient(135deg, #FF7A59 0%, #FA5B4A 100%) !important;
      box-shadow: 0 8px 24px rgba(250, 91, 74, 0.35) !important;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }
    .btn-coral-grad:hover {
      box-shadow: 0 12px 30px rgba(250, 91, 74, 0.48) !important;
      transform: translateY(-1px);
    }
    .btn-coral-grad:active {
      transform: scale(0.98);
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center px-4 text-white">
  <div class="w-full max-w-md bg-dark-800 border border-indigo-900/40 rounded-3xl shadow-2xl p-8 relative overflow-hidden backdrop-blur-xl">
    
    <!-- Ambient card accent -->
    <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-indigo-500 via-coral to-indigo-400"></div>
    
    <!-- Brand Logo & Header -->
    <div class="flex flex-col items-center mb-8 pt-2">
      <div class="w-12 h-12 rounded-2xl bg-indigo-600 flex items-center justify-center shadow-lg shadow-indigo-600/30 mb-3">
        <svg class="w-7 h-7" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 24V12L15 18L18 14L22 19L26 12V24" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="18" cy="14" r="2.5" fill="#FA5B4A"/>
        </svg>
      </div>
      <h1 class="text-xl font-extrabold tracking-tight text-white flex items-center gap-2">
        Maybla <span class="text-xs font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300">Studio</span>
      </h1>
      <p class="text-xs text-dark-400 mt-1 font-medium">Autonomous Cloud Broadcast Console</p>
    </div>
    
    <% if (error) { %>
      <div id="error-message" class="bg-red-500/10 border border-red-500/30 text-red-300 px-4 py-3 rounded-xl mb-6 text-sm flex items-center gap-2.5">
        <i class="ti ti-alert-circle text-lg text-red-400 flex-shrink-0"></i>
        <span><%= error %></span>
      </div>
    <% } %>
        
    <form action="/login" method="post" class="space-y-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <div>
        <label for="username" class="text-xs font-bold uppercase tracking-wider text-dark-400 block mb-2">Username</label>
        <div class="relative">
          <input type="text" id="username" name="username"
            class="w-full pl-11 pr-4 py-3 bg-dark-700/80 border border-dark-600 rounded-xl focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 text-white placeholder-dark-500 text-sm outline-none transition-all"
            placeholder="Enter your username" required>
          <i class="ti ti-user absolute left-3.5 top-1/2 -translate-y-1/2 text-dark-500 text-base"></i>
        </div>
      </div>
      
      <div>
        <label for="password" class="text-xs font-bold uppercase tracking-wider text-dark-400 block mb-2">Password</label>
        <div class="relative">
          <input type="password" id="password" name="password"
            class="w-full pl-11 pr-12 py-3 bg-dark-700/80 border border-dark-600 rounded-xl focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 text-white placeholder-dark-500 text-sm outline-none transition-all"
            placeholder="Enter your password" required>
          <i class="ti ti-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-dark-500 text-base"></i>
          <button type="button" onclick="togglePasswordVisibility()"
            class="absolute right-3.5 top-1/2 -translate-y-1/2 flex items-center justify-center text-dark-500 hover:text-white transition-colors">
            <i class="ti ti-eye text-base" id="passwordToggle"></i>
          </button>
        </div>
      </div>
      
      <% if (typeof recaptchaSiteKey !== 'undefined' && recaptchaSiteKey) { %>
      <div class="flex justify-center pt-1">
        <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>" data-theme="dark"></div>
      </div>
      <% } %>
      
      <button type="submit"
        class="btn-coral-grad w-full text-white py-3 rounded-full font-bold text-sm transition-all mt-2 cursor-pointer">
        Sign In to Studio &rarr;
      </button>
    </form>

    <div class="text-center mt-6 pt-4 border-t border-dark-700/60">
      <p class="text-dark-500 text-xs font-medium">
        Need access or lost credentials? 
        <a href="/signup" class="text-indigo-400 hover:text-coral font-bold transition-colors ml-1">Create Account</a>
      </p>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const icons = document.querySelectorAll('.ti');
      icons.forEach(icon => {
        icon.classList.add('font-loaded');
      });
    });

    function togglePasswordVisibility() {
      const password = document.getElementById('password');
      const passwordToggle = document.getElementById('passwordToggle');
      if (password.type === 'password') {
        password.type = 'text';
        passwordToggle.classList.remove('ti-eye');
        passwordToggle.classList.add('ti-eye-off');
      } else {
        password.type = 'password';
        passwordToggle.classList.remove('ti-eye-off');
        passwordToggle.classList.add('ti-eye');
      }
    }
  </script>
</body>
</html>